<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{% block title %}Sign in{% endblock %} · {{ app_name }}</title>
    <style>
        :root {
            --bg: #f4f5f7; --card: #ffffff; --text: #1d2330; --muted: #5d6676; --border: #d9dde4;
            --accent: #1f5eff; --accent-text: #ffffff; --error-bg: #fdecec; --error: #a4161a; --ok-bg: #e8f6ee; --ok: #19663b;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #12151b; --card: #1b2029; --text: #e7eaf0; --muted: #9aa3b2; --border: #2e3542;
                --accent: #5b8cff; --error-bg: #3a1c1e; --error: #ff9c9f; --ok-bg: #173225; --ok: #8fe0b1;
            }
        }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px;
               background: var(--bg); color: var(--text); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
        main { width: 100%; max-width: 400px; background: var(--card); border: 1px solid var(--border);
               border-radius: 12px; padding: 32px 28px; }
        h1 { font-size: 1.35rem; margin: 0 0 4px; }
        .sub { color: var(--muted); margin: 0 0 24px; font-size: .95rem; }
        label { display: block; font-weight: 600; font-size: .9rem; margin: 16px 0 6px; }
        input[type=text], input[type=password] { width: 100%; padding: 10px 12px; font: inherit; color: var(--text);
               background: transparent; border: 1px solid var(--border); border-radius: 8px; }
        input:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        button, a.button { display: block; text-align: center; text-decoration: none; box-sizing: border-box; width: 100%; margin-top: 24px; padding: 11px; font: inherit; font-weight: 600; cursor: pointer;
                 color: var(--accent-text); background: var(--accent); border: 0; border-radius: 8px; }
        button.secondary { background: transparent; color: var(--text); border: 1px solid var(--border); }
        .alert { padding: 10px 12px; border-radius: 8px; font-size: .92rem; margin-bottom: 16px; }
        .alert.error { background: var(--error-bg); color: var(--error); }
        .alert.ok { background: var(--ok-bg); color: var(--ok); }
        .code { letter-spacing: .3em; font-size: 1.3rem; text-align: center; font-variant-numeric: tabular-nums; }
        .links { margin-top: 20px; text-align: center; font-size: .9rem; }
        a { color: var(--accent); }
        .qr { display: block; margin: 8px auto 12px; width: 220px; height: 220px; background: #fff; padding: 10px; border-radius: 8px; }
        .secret { font-family: ui-monospace, monospace; text-align: center; color: var(--muted); word-break: break-all; }
        ol.codes { columns: 2; font-family: ui-monospace, monospace; padding-left: 1.4em; }
        dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; margin: 0; }
        dt { color: var(--muted); }
    </style>
</head>
<body>
<main>
    {% for type, messages in app.flashes(['error', 'success']) %}
        {% for message in messages %}
            <div class="alert {{ type == 'error' ? 'error' : 'ok' }}" role="status">{{ message }}</div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
</body>
</html>
