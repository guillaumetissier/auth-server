{
    "name": "guillaumetissier/auth-server",
    "description": "Standalone OAuth 2 authorization server: Authorization Code + PKCE, TOTP 2FA, DPoP-bound tokens.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.3",
        "endroid/qr-code": "^6.0",
        "guillaumetissier/resource-guard": "^0.1",
        "league/oauth2-server": "^9.2",
        "league/oauth2-server-bundle": "^2.0",
        "nyholm/psr7": "^1.8",
        "scheb/2fa-backup-code": "^7.6",
        "scheb/2fa-bundle": "^7.6",
        "scheb/2fa-totp": "^7.6",
        "symfony/cache": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/monolog-bundle": "^3.10 || ^4.0",
        "symfony/psr-http-message-bridge": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/var-exporter": "7.4.*",
        "symfony/yaml": "7.4.*",
        "web-token/jwt-library": "^4.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/dom-crawler": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": false
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "fixcs": "php-cs-fixer fix",
        "stan": [
            "@php bin/console cache:warmup --env=dev --quiet",
            "phpstan analyse --memory-limit=1G"
        ]
    },
    "scripts-descriptions": {
        "test": "Runs the test suite",
        "cs": "Checks the coding standard (no change)",
        "fixcs": "Fixes the coding standard",
        "stan": "Static analysis (PHPStan, level max, Symfony and Doctrine extensions)"
    }
}
