# Defaults; docker-compose.yml overrides them for the container.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=demo-only-not-a-secret
# Where the API downloads the auth server's public keys (inside the Docker network "auth-server").
AUTH_SERVER_JWKS_URI=http://auth-server:8080/.well-known/jwks.json
# Accept only tokens issued to these clients (comma-separated).
AUTH_SERVER_ALLOWED_CLIENTS=my-spa
# Origin of the demo SPA, allowed to call this API from the browser (CORS).
DEMO_SPA_ORIGIN=http://localhost:5173
