{
    "name": "guillaumetissier/auth-server-demo-api",
    "description": "Demo resource server: a small Symfony API protected by resource-guard",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-openssl": "*",
        "guillaumetissier/resource-guard": "^0.1",
        "nyholm/psr7": "^1.8",
        "symfony/cache": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
