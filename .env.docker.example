# Container settings for Docker Compose. "make secrets" copies this file to .env.docker (ignored by git)
# and fills the empty secrets with random values. Every variable of .env can be overridden here.

# Public URL of the auth server, as browsers reach it (no trailing slash).
APP_ISSUER=http://localhost:8080
# Reverse proxy addresses, when TLS is terminated in front of the container.
TRUSTED_PROXIES=

# Browser applications allowed to call the token endpoint (comma-separated origins).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Name shown in authenticator apps.
TOTP_ISSUER="Auth Server"
# 2FA: optional | grace | required (administrators always need it).
# grace = existing users may click "Later" at each login until APP_2FA_DEADLINE (e.g. 2026-12-31; empty = not decided yet).
APP_2FA_MODE=grace
APP_2FA_DEADLINE=
DPOP_REQUIRED_BY_DEFAULT=1

# Impersonation: session length, access token lifetime, scopes kept for read-only admins (ROLE_ADMIN).
IMPERSONATION_TTL=PT30M
IMPERSONATION_ACCESS_TOKEN_TTL=PT5M
IMPERSONATION_READONLY_SCOPES=profile,offline_access

# Rights every user holds on his own domain, e.g. "user:w:own" (everyone edits his own profile). Empty: none.
ACCESS_DEFAULT_EXPRESSION=

OAUTH_ACCESS_TOKEN_TTL=PT15M
OAUTH_REFRESH_TOKEN_TTL=P30D

# Comma-separated URLs receiving signed account events, e.g. http://my-app/auth-server/webhook
WEBHOOK_URLS=

# Database, shared with the MySQL container; Symfony composes DATABASE_URL from them (see .env).
# Keep the password URL-safe (make secrets generates hex), or set DATABASE_URL explicitly.
MYSQL_DATABASE=auth
MYSQL_USER=auth

# --- Secrets (generated by "make secrets") ---
APP_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
OAUTH_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY=
WEBHOOK_SECRET=
