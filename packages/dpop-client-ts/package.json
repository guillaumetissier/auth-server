{
  "name": "@guillaumetissier/oauth-dpop-client",
  "version": "1.0.0",
  "description": "Browser OAuth2 client for Authorization Code + PKCE with DPoP-bound tokens (RFC 9449), WebCrypto only, zero dependencies.",
  "keywords": ["oauth2", "pkce", "dpop", "rfc9449", "webcrypto", "spa"],
  "license": "MIT",
  "author": "Guillaume Tissier",
  "homepage": "https://github.com/guillaumetissier/auth-server/tree/main/packages/dpop-client-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillaumetissier/auth-server.git",
    "directory": "packages/dpop-client-ts"
  },
  "bugs": "https://github.com/guillaumetissier/auth-server/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/oauth-dpop.js",
  "types": "./dist/oauth-dpop.d.ts",
  "exports": {
    ".": {
      "types": "./dist/oauth-dpop.d.ts",
      "default": "./dist/oauth-dpop.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
