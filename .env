# Defaults for every environment. Real secrets go in .env.local (not committed)
# or in the container environment (docker-compose / orchestrator), which take precedence.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me-in-env-local-0123456789abcdef

# Public base URL of the auth server, as clients reach it (used in metadata and DPoP htu checks).
APP_ISSUER=http://localhost:8080

# Comma-separated list of reverse proxy IPs/CIDRs, e.g. "127.0.0.1,REMOTE_ADDR" or "10.0.0.0/8".
TRUSTED_PROXIES=

# MySQL connection. With Docker Compose the MYSQL_* variables come from .env.docker (shared with the
# MySQL container) and override these defaults, for every process: the server and "docker compose exec".
# Setting DATABASE_URL itself (e.g. in .env.local) takes precedence over the composed value.
MYSQL_HOST=auth-db
MYSQL_USER=auth
MYSQL_PASSWORD=auth
MYSQL_DATABASE=auth
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:3306/${MYSQL_DATABASE}?serverVersion=8.4.0&charset=utf8mb4"

###> OAuth2 ###
# RSA key pair signing the access tokens (generate with: bin/console app:keys:generate).
OAUTH_PRIVATE_KEY=%kernel.project_dir%/var/keys/private.pem
OAUTH_PUBLIC_KEY=%kernel.project_dir%/var/keys/public.pem
OAUTH_PASSPHRASE=
# Encrypts authorization codes and refresh tokens. Generate with: php -r 'echo bin2hex(random_bytes(32));'
OAUTH_ENCRYPTION_KEY=
OAUTH_ACCESS_TOKEN_TTL=PT15M
OAUTH_REFRESH_TOKEN_TTL=P30D
###< OAuth2 ###

###> Two-factor authentication ###
# Encrypts the TOTP secrets at rest (libsodium secretbox key, base64 of 32 random bytes).
# Generate with: php -r 'echo base64_encode(random_bytes(32));'
TOTP_ENCRYPTION_KEY=
# Name displayed in the authenticator app.
TOTP_ISSUER="Auth Server"
# optional | grace | required (administrators always need 2FA, whatever the mode).
#  - grace: users without 2FA are asked at each login and may click "Later" until APP_2FA_DEADLINE.
APP_2FA_MODE=grace
# Date from which 2FA becomes required in grace mode (e.g. 2026-12-31). Empty = not decided yet.
APP_2FA_DEADLINE=
###< Two-factor authentication ###

###> DPoP ###
# When 1, every client must present a DPoP proof at the token endpoint (per-client override: app:client:policy).
DPOP_REQUIRED_BY_DEFAULT=1
###< DPoP ###

# Origins of browser applications allowed to call the token endpoint (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173

###> Impersonation ###
# How long an administrator may act on behalf of a user (ISO 8601 duration).
IMPERSONATION_TTL=PT30M
# Access tokens issued during an impersonation live at most this long.
IMPERSONATION_ACCESS_TOKEN_TTL=PT5M
# Scopes kept in read-only impersonations (ROLE_ADMIN). Writes are refused by resource servers anyway.
IMPERSONATION_READONLY_SCOPES=profile,offline_access

# Rights every user of a domain holds on his own domain, as an access expression (e.g. "user:w:own":
# everyone edits his own profile). Empty: none.
ACCESS_DEFAULT_EXPRESSION=
###< Impersonation ###

###> Webhooks ###
# Comma-separated list of URLs receiving signed events (empty = disabled).
WEBHOOK_URLS=
# Shared HMAC secret, min. 32 chars, identical on the receiving side.
WEBHOOK_SECRET=
###< Webhooks ###
