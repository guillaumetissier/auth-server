{% extends 'base.html.twig' %}

{% block title %}{{ 'impersonation.confirm.act_on_behalf_username'|trans({'{username}': target.username}) }}{% endblock %}

{% block body %}
    <h1>{{ 'impersonation.confirm.act_on_behalf_username'|trans({'{username}': target.username}) }}</h1>
    <p class="sub">
        {% if mode == 'full' %}
            {{ 'impersonation.confirm.you_will_have_all_rights'|trans({'{minutes}': ttl_minutes})|raw }}
        {% else %}
            {{ 'impersonation.confirm.you_will_have_read_only'|trans({'{minutes}': ttl_minutes})|raw }}
        {% endif %}
    </p>

    {% for error in errors %}
        <div class="alert error" role="alert">{{ error|trans }}</div>
    {% endfor %}

    <form method="post">
        <label for="reason">{{ 'impersonation.confirm.reason_ticket_request'|trans }}</label>
        <input type="text" id="reason" name="reason" value="{{ reason }}" minlength="10" maxlength="500" required autofocus>

        <label for="code">{{ 'impersonation.confirm.authentication_code'|trans }}</label>
        <input type="text" id="code" name="code" class="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
               autocomplete="one-time-code" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('impersonation_confirm') }}">
        <button type="submit">{{ 'impersonation.confirm.start'|trans }}</button>
    </form>

    <p class="links"><a href="{{ path('app_account') }}">{{ 'common.cancel'|trans }}</a></p>
{% endblock %}
