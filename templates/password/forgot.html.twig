{% extends 'base.html.twig' %}

{% block title %}{{ 'common.forgot_password'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'common.forgot_password'|trans }}</h1>
    {% if sent %}
        <div class="alert ok" role="status">{{ 'password.forgot.if_account_matches_e_mail'|trans }}</div>
        <p class="sub">{{ 'password.forgot.nothing_after_few_minutes_check'|trans }}</p>
    {% else %}
        <p class="sub">{{ 'password.forgot.give_username_or_e_mail'|trans }}</p>
        <form method="post">
            <label for="identifier">{{ 'password.forgot.username_or_e_mail_address'|trans }}</label>
            <input type="text" id="identifier" name="identifier" autocomplete="username" required autofocus>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_forgot') }}">
            <button type="submit">{{ 'password.forgot.send_link'|trans }}</button>
        </form>
    {% endif %}
    <p class="links"><a href="{{ path('app_login') }}">{{ 'password.forgot.back_to_sign_in'|trans }}</a></p>
{% endblock %}
