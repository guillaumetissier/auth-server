<p>{{ 'email.password_link.hello_username'|trans({'{username}': username}) }}</p>
{% if purpose == 'invitation' %}
    <p>{{ 'email.password_link.account_was_created_for_you'|trans({'{app}': app_name}) }}</p>
{% else %}
    <p>{{ 'email.password_link.someone_probably_you_or_administrator'|trans({'{app}': app_name}) }}</p>
{% endif %}
<p><a href="{{ url }}">{{ url }}</a></p>
<p>{{ 'email.password_link.link_works_once_html'|trans({'{date}': expires_at|locale_date('datetime') ~ ' ' ~ expires_at|date('T'), '{username}': username|e})|raw }}</p>
{% if purpose != 'invitation' %}
    <p>{{ 'email.password_link.you_did_not_ask_for'|trans }}</p>
{% endif %}
