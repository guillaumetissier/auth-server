{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ target.username }}{% endblock %}

{% block content %}
    <p class="muted"><a href="{{ path('app_admin_users') }}">{{ 'common.users'|trans }}</a> /</p>
    <h1>{{ target.username }}
        {% if 'ROLE_SUPER_ADMIN' in target.roles %}<span class="badge">{{ 'admin.super_admin'|trans }}</span>{% elseif 'ROLE_ADMIN' in target.roles %}<span class="badge">{{ 'admin.admin'|trans }}</span>{% endif %}
        {% if not target.enabled %}<span class="badge warn">{{ 'common.disabled'|trans }}</span>{% elseif target.isLocked(now) %}<span class="badge warn">{{ 'admin.locked'|trans }}</span>{% endif %}
    </h1>

    <h2>{{ 'common.account'|trans }}</h2>
    <dl>
        <dt>{{ 'common.user_id'|trans }}</dt><dd class="expr">{{ target.externalUserId }}</dd>
        <dt>{{ 'common.e_mail'|trans }}</dt><dd>{{ target.email ?? '—' }}</dd>
        <dt>{{ 'common.language'|trans }}</dt><dd>{{ target.locale ? app_locales()[target.locale] ?? target.locale : 'admin.user.same_as_browser'|trans }}</dd>
        <dt>{{ 'common.domain'|trans }}</dt><dd>{% if target.domain %}<a href="{{ path('app_admin_domain', {code: target.domain.code}) }}" class="expr">{{ target.domain.path }}</a>{% else %}—{% endif %}</dd>
        <dt>{{ 'admin.two_factor'|trans }}</dt><dd>{% if target.totpEnabledAt %}<span class="badge ok">{{ 'common.enabled'|trans }}</span> {{ 'admin.user.since_date'|trans({'{date}': target.totpEnabledAt|locale_date}) }}{% else %}<span class="badge warn">{{ 'common.not_enabled'|trans }}</span>{% if target.twoFactorPostponeCount > 0 %} · {{ 'admin.user.postponed_count'|trans({'{count}': target.twoFactorPostponeCount}) }}{% endif %}{% endif %}</dd>
        <dt>{{ 'admin.status'|trans }}</dt><dd>{% if not target.enabled %}{{ 'common.disabled'|trans }}{% elseif target.isLocked(now) %}{{ 'admin.user.locked_until_time_too_many'|trans({'{time}': target.lockedUntil|locale_date('time')}) }}{% else %}{{ 'admin.active'|trans }}{% endif %}</dd>
        <dt>{{ 'admin.last_sign_in'|trans }}</dt><dd>{{ target.lastLoginAt ? target.lastLoginAt|locale_date('datetime') : 'admin.user.never'|trans }}</dd>
        <dt>{{ 'common.created'|trans }}</dt><dd>{{ target.createdAt|locale_date }}</dd>
        {% if target.passwordLinkExpiresAt and target.passwordLinkExpiresAt > now %}<dt>{{ 'admin.user.password_link'|trans }}</dt><dd>{{ 'admin.user.pending_valid_until_date'|trans({'{date}': target.passwordLinkExpiresAt|locale_date('datetime')}) }}</dd>{% endif %}
    </dl>

    {% if account_denial %}
        <p class="help">{{ account_denial|trans }}</p>
    {% else %}
        <div class="actions toolbar">
            <button type="button" class="secondary" data-dialog="identity-dialog">{{ 'admin.edit'|trans }}</button>
            <form method="post" action="{{ path('app_admin_user_password_link', {id: target.id}) }}" class="inline"
                  data-confirm-title="{{ 'admin.user.send_password_link_to_username'|trans({'{username}': target.username}) }}" data-confirm-button="{{ 'admin.user.send'|trans }}" data-confirm-danger="0"
                  data-confirm-text="{{ 'admin.user.e_mails_email_link_to'|trans({'{email}': target.email ?? ''}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
                <button type="submit" class="secondary"{% if not target.email %} disabled title="{{ 'admin.user.add_e_mail_address_first'|trans }}"{% elseif not target.enabled %} disabled title="{{ 'admin.user.account_is_disabled'|trans }}"{% endif %}>{{ 'admin.user.send_password_link'|trans }}</button>
            </form>
            <form method="post" action="{{ path('app_admin_user_2fa_reset', {id: target.id}) }}" class="inline"
                  data-confirm-title="{{ 'admin.user.reset_two_factor_authentication_username'|trans({'{username}': target.username}) }}" data-confirm-button="{{ 'admin.user.reset'|trans }}"
                  data-confirm-text="{{ 'admin.user.for_lost_phone_user_sets'|trans }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
                <button type="submit" class="secondary"{% if not target.totpEnabledAt %} disabled title="{{ 'admin.user.two_factor_authentication_is_not'|trans }}"{% endif %}>{{ 'admin.user.reset_2fa'|trans }}</button>
            </form>
        </div>

        <dialog id="identity-dialog" class="modal" aria-labelledby="identity-dialog-title">
            <form method="post" action="{{ path('app_admin_user_identity', {id: target.id}) }}">
                <h2 id="identity-dialog-title">{{ 'admin.user.edit_username'|trans({'{username}': target.username}) }}</h2>
                <label for="a-username">{{ 'common.username'|trans }}</label>
                <input type="text" id="a-username" name="username" value="{{ target.username }}" required>
                <label for="a-email">{{ 'common.e_mail_address'|trans }}</label>
                <input type="email" id="a-email" name="email" value="{{ target.email }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
                <div class="actions">
                    <button type="submit">{{ 'admin.save'|trans }}</button>
                    <button type="button" class="secondary" data-close-dialog>{{ 'common.cancel'|trans }}</button>
                </div>
            </form>
        </dialog>
    {% endif %}

    {% if impersonation_mode %}
        <hr class="section">
        <h2>{{ 'admin.user.impersonate'|trans }}</h2>
        {% if impersonation_entry_points is empty %}
            <p class="help">{{ 'admin.user.no_application_has_impersonation_entry'|trans }}
                (<code>app:client:policy &lt;client&gt; --impersonation-uri="https://…/impersonate?user={user}"</code>).</p>
        {% else %}
            <p class="help">{{ (impersonation_mode == 'full'
                ? 'admin.user.impersonate_help_full'
                : 'admin.user.impersonate_help_read_only')|trans({'{username}': target.username}) }}</p>
            {% for e in impersonation_entry_points %}
                <a class="button" href="{{ e.uri }}" rel="noopener">{{ 'admin.user.impersonate_in_application'|trans({'{application}': e.name}) }}</a>
            {% endfor %}
        {% endif %}
    {% endif %}

    <hr class="section">
    <h2>{{ 'common.rights'|trans }}</h2>
    <table>
        <thead><tr><th>{{ 'common.domain'|trans }}</th><th>{{ 'common.subdomains'|trans }}</th><th>{{ 'common.rights'|trans }}</th><th>{{ 'admin.user.origin'|trans }}</th><th></th></tr></thead>
        <tbody>
        {% for g in grants %}
            <tr>
                <td class="expr">{{ g.domain.path }}</td>
                <td>{{ (g.includesSubdomains ? 'common.yes' : 'common.no')|trans }}</td>
                <td>{% if g.profile %}
                        <a href="{{ path('app_admin_profile', {code: g.profile.code}) }}" class="badge">{{ g.profile.name }}</a>
                        {% if not g.adjustments.isEmpty %}<span class="muted">{{ 'admin.user.adjusted'|trans }}</span> <span class="expr">{{ g.adjustments }}</span>{% endif %}
                        <div class="expr muted">= {{ g.expression }}</div>
                    {% else %}<span class="expr">{{ g.expression }}</span>{% endif %}</td>
                <td class="muted">{{ (g.grantedBy ? 'admin.user.granted_by_username_date' : 'admin.user.granted_date')|trans({'{username}': g.grantedBy ? g.grantedBy.username : '', '{date}': g.updatedAt|locale_date}) }}</td>
                <td class="num nowrap">{% if not change_denial %}
                    {% if g.domain.code in grantable_domains|map(d => d.code) %}
                        <button type="button" class="small secondary" data-dialog="grant-dialog"
                                data-fields="{{ {domain: g.domain.code, profile: g.profile ? g.profile.code : '', rights: g.profile ? g.adjustments.toString : g.expression.toString, subdomains: g.includesSubdomains}|json_encode }}">{{ 'admin.edit'|trans }}</button>
                    {% endif %}
                    <form method="post" action="{{ path('app_admin_user_revoke', {id: target.id, grant: g.id}) }}" class="inline"
                          data-confirm-title="{{ 'admin.user.remove_rights_username_on_domain'|trans({'{username}': target.username, '{domain}': g.domain.path}) }}"
                          data-confirm-text="{{ g.expression.isEmpty ? '' : 'admin.user.he_loses_rights_it_applies'|trans({'{rights}': g.expression.toString}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
                        <button type="submit" class="small danger">{{ 'admin.remove'|trans }}</button>
                    </form>
                {% endif %}</td>
            </tr>
        {% endfor %}
        {% for d in owned %}
            <tr><td class="expr">{{ d.path }}</td><td>{{ 'common.yes'|trans }}</td><td class="expr">{{ d.ownerExpression }}</td><td class="muted">{{ 'admin.user.owner_domain'|trans({'{domain}': d.code}) }}</td><td></td></tr>
        {% endfor %}
        {% if target.domain and default_expression %}
            <tr><td class="expr">{{ target.domain.path }}</td><td>{{ 'common.yes'|trans }}</td><td class="expr">{{ default_expression }}</td><td class="muted">{{ 'admin.user.default_for_everyone'|trans }}</td><td></td></tr>
        {% endif %}
        {% if grants is empty and owned is empty and (not target.domain or not default_expression) %}
            <tr><td colspan="5" class="muted">{{ 'admin.user.no_rights'|trans }}</td></tr>
        {% endif %}
        </tbody>
    </table>

    {% if change_denial %}
        <p class="help">{{ change_denial|trans }}</p>
    {% elseif grantable_domains is not empty %}
        <div class="actions toolbar"><button type="button" data-dialog="grant-dialog">{{ 'admin.user.add'|trans }}</button></div>

        <dialog id="grant-dialog" class="modal modal-wide" aria-labelledby="grant-dialog-title">
            <form method="post" action="{{ path('app_admin_user_grant', {id: target.id}) }}">
                <h2 id="grant-dialog-title">{{ 'admin.user.grant_or_replace_rights'|trans }}</h2>
                <p class="help">{{ 'admin.user.one_grant_per_domain_saving'|trans({'{username}': target.username}) }}</p>
                <div class="row">
                    <div class="grow"><label for="g-domain">{{ 'common.domain'|trans }}</label>
                        <select id="g-domain" name="domain">
                            {% for d in grantable_domains %}<option value="{{ d.code }}">{{ d.path }}</option>{% endfor %}
                        </select></div>
                    {% if profiles is not empty %}
                        <div class="grow"><label for="g-profile">{{ 'admin.profile_label'|trans }}</label>
                            <select id="g-profile" name="profile">
                                <option value="">{{ 'admin.user.none'|trans }}</option>
                                {% for p in profiles %}<option value="{{ p.code }}" title="{{ p.expression }}">{{ p.name }} ({{ p.expression }})</option>{% endfor %}
                            </select></div>
                    {% endif %}
                </div>
                <label for="g-rights">{{ (profiles is not empty ? 'admin.user.rights_or_adjustments_profile' : 'common.rights')|trans }}</label>
                <input type="text" id="g-rights" name="rights" class="expr" {{ profiles is empty ? 'required' }} placeholder="*:r vehicle:w user:w:own">
                {% if profiles is not empty %}
                    <p class="help">{{ 'admin.user.with_profile_field_adjusts_it'|trans({'{url}': path('app_admin_profiles')})|raw }}</p>
                {% endif %}
                <p class="help">{{ 'admin.types'|trans }} {% for t in resource_types %}<code>{{ t.code }}</code> {% for f in t.facets %}<code title="{{ f.description ?? f.label }}">{{ f.code }}</code> {% endfor %}{% endfor %}{% for code, label in reserved_types %}<code title="{{ ('resource_type.reserved.' ~ code|slice(1))|trans }}">{{ code }}</code> {% endfor %}
                    · <a href="{{ path('app_admin_resource_types') }}">{{ 'admin.syntax'|trans }}</a>. {{ 'admin.user.you_can_never_grant_more'|trans }}</p>
                <label class="check"><input type="checkbox" name="subdomains" value="1" checked> {{ 'admin.user.also_on_subdomains'|trans }}</label>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
                <div class="actions">
                    <button type="submit">{{ 'admin.save'|trans }}</button>
                    <button type="button" class="secondary" data-close-dialog>{{ 'common.cancel'|trans }}</button>
                </div>
            </form>
        </dialog>
    {% endif %}

    {% if preview_domain %}
        <hr class="section">
        <h2>{{ 'admin.user.what_it_gives'|trans }}</h2>
        <form method="get" class="row">
            <div class="grow"><label for="p-domain">{{ 'admin.user.on_domain'|trans }}</label>
                <select id="p-domain" name="preview">
                    {% for d in preview_domains %}<option value="{{ d.code }}" {{ d.id == preview_domain.id ? 'selected' }}>{{ d.path }}</option>{% endfor %}
                </select></div>
            <div><button type="submit" class="secondary">{{ 'admin.user.show'|trans }}</button></div>
        </form>
        <table style="margin-top: 12px">
            <thead><tr><th>{{ 'admin.type'|trans }}</th><th>{{ 'admin.user.any_resource'|trans }}</th><th>{{ 'admin.user.own_resources'|trans }}</th></tr></thead>
            <tbody>
            {% for r in preview %}
                <tr{% if r.facet %} class="facet"{% endif %}>
                    <td>{% if r.facet %}<span class="muted">↳</span> {% endif %}<span class="expr">{{ r.type }}</span> <span class="muted">{{ r.reserved ? '' : r.label }}</span></td>
                    <td>{% include 'admin/_level.html.twig' with {level: r.level} %}</td>
                    <td>{% if r.own != r.level %}{% include 'admin/_level.html.twig' with {level: r.own} %}{% endif %}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <p class="help">{{ 'admin.user.as_resource_servers_compute_it'|trans }}</p>
    {% endif %}

    {% if can_change_roles %}
        <hr class="section">
        <h2>{{ 'admin.user.platform_role'|trans }}</h2>
        <form method="post" action="{{ path('app_admin_user_roles', {id: target.id}) }}">
            <label class="check"><input type="checkbox" name="admin" value="1" {{ 'ROLE_ADMIN' in target.roles ? 'checked' }}>
                {{ 'admin.user.platform_administrator_sees_every_domain'|trans }}</label>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
            <button type="submit" class="secondary">{{ 'admin.save'|trans }}</button>
        </form>
    {% endif %}

    {% if not account_denial %}
        <hr class="section">
        <section class="danger">
            <h2>{{ 'admin.user.status_and_deletion'|trans }}</h2>
            <form method="post" action="{{ path('app_admin_user_status', {id: target.id}) }}">
                <input type="hidden" name="enabled" value="{{ target.enabled ? 0 : 1 }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
                {% if target.enabled %}
                    <button type="submit" class="danger">{{ 'admin.user.disable_account'|trans }}</button>
                    <p class="help">{{ 'admin.user.user_can_no_longer_sign'|trans }}</p>
                {% else %}
                    <button type="submit">{{ 'admin.user.enable_account'|trans }}</button>
                {% endif %}
            </form>
            <form method="post" action="{{ path('app_admin_user_delete', {id: target.id}) }}">
                <div class="row">
                    <div class="grow"><label for="confirm-delete">{{ 'admin.user.to_delete_account_for_good'|trans({'{username}': target.username}) }}</label>
                        <input type="text" id="confirm-delete" name="confirm" autocomplete="off" required></div>
                    <div><button type="submit" class="danger">{{ 'admin.user.delete_account'|trans }}</button></div>
                </div>
                <p class="help">{{ 'admin.user.removes_account_rights_and_impersonation'|trans }}</p>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
            </form>
        </section>
    {% endif %}
    {% include 'admin/_confirm.html.twig' %}
    <script src="/scripts/dialogs.js" defer></script>
{% endblock %}
