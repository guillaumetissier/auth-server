{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ 'common.settings'|trans }}{% endblock %}

{% macro source(row, default) %}
    {% if row %}
        <span class="help">{{ 'admin.settings.set_by_username_on_date'|trans({
            '{username}': (row.updatedBy ? row.updatedBy.username : 'admin.settings.deleted_account'|trans)|e,
            '{date}': row.updatedAt|locale_date('datetime'),
            '{default}': (default == '' ? 'admin.settings.empty'|trans : default|trans)|e,
        })|raw }}</span>
    {% else %}
        <span class="help">{{ 'admin.settings.default_server_configuration_env_docker'|trans }}</span>
    {% endif %}
{% endmacro %}

{% block content %}
    <h1>{{ 'common.settings'|trans }}</h1>
    <p class="sub">{{ 'admin.settings.they_apply_at_once_to'|trans }}
        {% if not can_edit %}{{ 'admin.settings.only_super_administrator_changes_them'|trans }}{% endif %}</p>

    <form method="post" action="{{ path('app_admin_settings_save') }}">
        <h2>{{ 'admin.settings.token_security'|trans }}</h2>

        <label class="check"><input type="checkbox" name="dpop_required" value="1" {{ dpop_required ? 'checked' }} {{ can_edit ? '' : 'disabled' }}>
            {{ 'admin.settings.applications_must_use_dpop'|trans }}</label>
        <p class="help">{{ 'admin.settings.with_dpop_each_token_is'|trans }}</p>
        {{ _self.source(rows['dpop.required_by_default'], defaults['dpop.required_by_default'] == '1' ? 'admin.settings.rule_required' : 'admin.settings.rule_not_required') }}

        <label class="check" style="margin-top: 18px"><input type="checkbox" name="pkce_confidential" value="1" {{ pkce_confidential ? 'checked' }} {{ can_edit ? '' : 'disabled' }}>
            {{ 'admin.settings.pkce_also_for_confidential_applications'|trans }}</label>
        <p class="help">{{ 'admin.settings.pkce_s256_protects_sign_in'|trans|raw }}</p>
        {{ _self.source(rows['pkce.confidential_clients'], defaults['pkce.confidential_clients'] == '1' ? 'admin.settings.rule_required' : 'admin.settings.rule_not_required') }}

        <h2>{{ 'admin.settings.token_lifetimes'|trans }}</h2>
        <table>
            <thead><tr><th>{{ 'admin.settings.lifetime'|trans }}</th><th style="width: 260px">{{ 'admin.settings.duration'|trans }}</th><th>{{ 'admin.settings.default'|trans }}</th></tr></thead>
            <tbody>
            {% for name, l in lifetimes %}
                <tr>
                    <td><strong>{{ l.label|trans }}</strong><p class="help">{{ l.help|trans }} {{ 'admin.settings.allowed_range'|trans({'{range}': l.range|trans}) }}</p>
                        {{ _self.source(rows[name], l.default) }}</td>
                    <td>
                        <div class="row" style="flex-wrap: nowrap">
                            <div style="flex: 1 1 80px"><input type="text" inputmode="numeric" name="{{ l.field }}_amount" value="{{ l.amount }}" aria-label="{{ 'admin.settings.label_amount'|trans({'{label}': l.label|trans}) }}" required {{ can_edit ? '' : 'disabled' }}></div>
                            <div style="flex: 1 1 110px"><select name="{{ l.field }}_unit" aria-label="{{ 'admin.settings.label_unit'|trans({'{label}': l.label|trans}) }}" {{ can_edit ? '' : 'disabled' }}>
                                {% for u in units %}<option value="{{ u }}" {{ u == l.unit ? 'selected' }}>{{ ('duration.unit.' ~ u)|trans }}</option>{% endfor %}
                            </select></div>
                        </div>
                    </td>
                    <td>{{ l.default|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <p class="help">{{ 'admin.settings.changes_apply_to_tokens_issued'|trans }}</p>

        <h2>{{ 'common.two_factor_authentication'|trans }}</h2>
        <div class="row">
            <div>
                <label for="tf-mode">{{ 'admin.settings.mode'|trans }}</label>
                <select id="tf-mode" name="two_factor_mode" {{ can_edit ? '' : 'disabled' }}>
                    <option value="optional" {{ two_factor_mode == 'optional' ? 'selected' }}>{{ 'admin.settings.optional'|trans }}</option>
                    <option value="grace" {{ two_factor_mode == 'grace' ? 'selected' }}>{{ 'admin.settings.grace_period'|trans }}</option>
                    <option value="required" {{ two_factor_mode == 'required' ? 'selected' }}>{{ 'admin.settings.required'|trans }}</option>
                </select>
            </div>
            <div>
                <label for="tf-deadline">{{ 'admin.settings.required_from_grace_period'|trans }}</label>
                <input type="date" id="tf-deadline" name="two_factor_deadline" value="{{ two_factor_deadline ? two_factor_deadline|date('Y-m-d') : '' }}" {{ can_edit ? '' : 'disabled' }}
                       style="width: 100%; padding: 8px 10px; font: inherit; color: var(--text); background: transparent; border: 1px solid var(--border); border-radius: 8px">
            </div>
        </div>
        <table style="margin-top: 12px">
            <tbody>
            <tr><td><strong>{{ 'admin.settings.optional'|trans }}</strong></td><td>{{ 'admin.settings.users_set_it_up_if'|trans }}</td></tr>
            <tr><td><strong>{{ 'admin.settings.grace_period'|trans }}</strong></td><td>{{ 'admin.settings.users_without_2fa_are_asked'|trans }}</td></tr>
            <tr><td><strong>{{ 'admin.settings.required'|trans }}</strong></td><td>{{ 'admin.settings.users_without_2fa_must_set'|trans }}</td></tr>
            </tbody>
        </table>
        <p class="help">{{ 'admin.settings.administrators_always_need_two_factor'|trans }}</p>
        {{ _self.source(rows['two_factor.mode'], defaults['two_factor.mode']) }}<br>
        {{ _self.source(rows['two_factor.deadline'], defaults['two_factor.deadline']) }}

        <h2>{{ 'common.language'|trans }}</h2>
        <label for="default-locale">{{ 'admin.settings.default_language_pages_and_e'|trans }}</label>
        <select id="default-locale" name="default_locale" {{ can_edit ? '' : 'disabled' }}>
            {% for code, name in app_locales() %}<option value="{{ code }}" lang="{{ code }}" {{ code == default_locale ? 'selected' }}>{{ name }}</option>{% endfor %}
        </select>
        <p class="help">{{ 'admin.settings.for_whoever_has_chosen_no'|trans }}</p>
        {{ _self.source(rows['ui.default_locale'], app_locales()[defaults['ui.default_locale']] ?? defaults['ui.default_locale']) }}

        {% if can_edit %}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_settings') }}">
            <div><button type="submit">{{ 'admin.settings.save_settings'|trans }}</button></div>
        {% endif %}
    </form>
    {% if can_edit %}
        <form method="post" action="{{ path('app_admin_settings_save') }}">
            <input type="hidden" name="use_defaults" value="1">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_settings') }}">
            <button type="submit" class="secondary">{{ 'admin.settings.use_defaults_server_configuration'|trans }}</button>
        </form>
    {% endif %}

    <h2>{{ 'admin.settings.applications'|trans }}</h2>
    <p class="help">{{ 'admin.settings.applications_registered_with_make_client'|trans|raw }}</p>
    <table>
        <thead><tr><th>{{ 'admin.settings.application'|trans }}</th><th>{{ 'admin.type'|trans }}</th><th>{{ 'admin.settings.redirect_address'|trans }}</th><th>DPoP</th></tr></thead>
        <tbody>
        {% for c in clients %}
            {% set p = policies[c.identifier] ?? null %}
            {% set rule = p is null or p.requiresDpop is null ? 'default' : (p.requiresDpop ? 'required' : 'bearer') %}
            <tr>
                <td>{{ c.name }}<br><code>{{ c.identifier }}</code></td>
                <td>{{ (c.confidential ? 'admin.settings.confidential_secret' : 'admin.settings.public_browser')|trans }}</td>
                <td class="expr">{% for u in c.redirectUris %}{{ u }}<br>{% endfor %}</td>
                <td>
                    {% if can_edit %}
                        <form method="post" action="{{ path('app_admin_settings_client', {identifier: c.identifier}) }}" class="row">
                            <div><select name="dpop" aria-label="{{ 'admin.settings.dpop_rule_name'|trans({'{name}': c.name}) }}">
                                <option value="default" {{ rule == 'default' ? 'selected' }}>{{ 'admin.settings.follow_setting_rule'|trans({'{rule}': (dpop_required ? 'admin.settings.rule_required' : 'admin.settings.rule_not_required')|trans}) }}</option>
                                <option value="required" {{ rule == 'required' ? 'selected' }}>{{ 'admin.settings.required'|trans }}</option>
                                <option value="bearer" {{ rule == 'bearer' ? 'selected' }}>{{ 'admin.settings.not_required_bearer_allowed'|trans }}</option>
                            </select></div>
                            <div style="flex: 0 0 auto"><button type="submit" class="small secondary">{{ 'admin.save'|trans }}</button></div>
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_settings') }}">
                        </form>
                    {% else %}
                        {{ (rule == 'default' ? 'admin.settings.follows_setting' : (rule == 'required' ? 'admin.settings.rule_required' : 'admin.settings.rule_not_required'))|trans }}
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="muted">{{ 'admin.settings.no_application_yet'|trans }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
