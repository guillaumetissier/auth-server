{# Confirmation dialog for forms marked with data-confirm-title / data-confirm-text (public/scripts/confirm.js). #}
<dialog id="confirm-dialog" class="modal" aria-labelledby="confirm-dialog-title">
    <div class="modal-body">
        <h2 id="confirm-dialog-title">{{ 'admin.confirm.are_you_sure'|trans }}</h2>
        <p data-confirm-text></p>
        <div class="actions">
            <button type="button" class="danger" data-confirm data-default-label="{{ 'admin.remove'|trans }}">{{ 'admin.remove'|trans }}</button>
            <button type="button" class="secondary" data-close-dialog>{{ 'common.cancel'|trans }}</button>
        </div>
    </div>
</dialog>
<script src="/scripts/confirm.js" defer></script>
