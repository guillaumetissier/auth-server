{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ profile.name }}{% endblock %}

{% block content %}
    <p class="sub"><a href="{{ path('app_admin_profiles') }}">Profiles</a></p>
    <h1>{{ profile.name }}</h1>

    <dl class="facts">
        <dt>Code</dt><dd class="expr">{{ profile.code }}</dd>
        <dt>Rights</dt><dd class="expr">{{ profile.expression }}</dd>
        <dt>Description</dt><dd>{{ profile.description ?? '—' }}</dd>
        <dt>Changed</dt><dd>{{ profile.updatedAt|date('Y-m-d H:i') }}</dd>
    </dl>
    {% if can_edit %}
        <div class="actions">{{ include('admin/_profile_operations.html.twig', {p: profile, used: grants|length}) }}</div>
    {% endif %}

    <h2>Given to</h2>
    <table>
        <thead><tr><th>User</th><th>Domain</th><th>Adjustments</th><th>Resulting rights</th></tr></thead>
        <tbody>
        {% for g in grants %}
            <tr>
                <td><a href="{{ path('app_admin_user', {id: g.user.id}) }}">{{ g.user.username }}</a></td>
                <td class="expr">{{ g.domain.path }}{{ g.includesSubdomains ? ' and subdomains' : '' }}</td>
                <td class="expr">{{ g.adjustments.isEmpty ? '—' : g.adjustments }}</td>
                <td class="expr">{{ g.expression }}</td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="muted">Nobody has this profile yet: give it from a user's page (Rights).</td></tr>
        {% endfor %}
        </tbody>
    </table>

    {% if can_edit %}
        {{ include('admin/_profile_dialog.html.twig', {from: 'detail'}) }}
        {% include 'admin/_confirm.html.twig' %}
    {% endif %}
{% endblock %}
