{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ 'common.domains'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'common.domains'|trans }}</h1>
    <p class="sub">{{ 'admin.domains.users_only_reach_their_own'|trans }}</p>

    {% if domains is empty %}
        <p class="muted">{{ 'admin.domains.no_domain_yet'|trans }}</p>
    {% else %}
        <table>
            <thead><tr><th>{{ 'common.domain'|trans }}</th><th>{{ 'common.name'|trans }}</th><th class="num">{{ 'common.users'|trans }}</th><th>{{ 'admin.owner'|trans }}</th><th>{{ 'admin.owner_rights'|trans }}</th><th>{{ 'common.created'|trans }}</th></tr></thead>
            <tbody>
            {% set base = domains|first.depth %}
            {% for d in domains %}
                <tr>
                    <td><span class="tree" style="--depth: {{ d.depth - base }}"><a href="{{ path('app_admin_domain', {code: d.code}) }}">{{ d.code }}</a></span></td>
                    <td>{{ d.name }}</td>
                    <td class="num">{{ members[d.id] ?? 0 }}</td>
                    <td>{{ d.owner ? d.owner.username : '—' }}</td>
                    <td class="expr">{{ d.ownerExpression }}</td>
                    <td>{{ d.createdAt|locale_date }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if can_create_root %}
        <h2>{{ 'admin.domains.new_top_level_domain'|trans }}</h2>
        {% include 'admin/_domain_form.html.twig' with {parent: null} %}
    {% endif %}
{% endblock %}
