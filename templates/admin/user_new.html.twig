{% extends 'admin/_layout.html.twig' %}

{% block title %}New user{% endblock %}

{% block content %}
    <p class="muted"><a href="{{ path('app_admin_users') }}">Users</a> /</p>
    <h1>New user</h1>
    <p class="sub">The user receives an e-mail with a link to choose his password (valid 7 days by default).</p>

    <form method="post" style="max-width: 640px">
        <label for="username">Username (used to sign in)</label>
        <input type="text" id="username" name="username" value="{{ values.username }}" required autofocus>

        <label for="external-id">User id in your application</label>
        <input type="text" id="external-id" name="external_user_id" value="{{ values.external_user_id }}" required maxlength="64">
        <p class="help">The id of this person in your application's database. It becomes the <code>sub</code> of the tokens, and cannot be changed later.</p>

        <label for="email">E-mail address</label>
        <input type="email" id="email" name="email" value="{{ values.email }}" required>

        <label for="domain">Domain</label>
        <select id="domain" name="domain">
            {% if can_choose_none %}<option value="">— no domain (platform staff) —</option>{% endif %}
            {% for d in domains %}<option value="{{ d.code }}" {{ d.code == values.domain ? 'selected' }}>{{ d.path }} · {{ d.name }}</option>{% endfor %}
        </select>
        <p class="help">Rights are given after creation, on the user's page.</p>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
        <button type="submit">Create and send the invitation</button>
    </form>
{% endblock %}
