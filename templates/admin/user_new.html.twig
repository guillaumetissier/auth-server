{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ 'admin.new_user'|trans }}{% endblock %}

{% block content %}
    <p class="muted"><a href="{{ path('app_admin_users') }}">{{ 'common.users'|trans }}</a> /</p>
    <h1>{{ 'admin.new_user'|trans }}</h1>
    <p class="sub">{{ 'admin.user_new.user_receives_e_mail_with'|trans }}</p>

    <form method="post" style="max-width: 640px">
        <label for="username">{{ 'admin.user_new.username_used_to_sign_in'|trans }}</label>
        <input type="text" id="username" name="username" value="{{ values.username }}" required autofocus>

        <label for="external-id">{{ 'admin.user_new.user_id_in_application'|trans }}</label>
        <input type="text" id="external-id" name="external_user_id" value="{{ values.external_user_id }}" required maxlength="64">
        <p class="help">{{ 'admin.user_new.id_person_in_applications_database'|trans|raw }}</p>

        <label for="email">{{ 'common.e_mail_address'|trans }}</label>
        <input type="email" id="email" name="email" value="{{ values.email }}" required>

        <label for="domain">{{ 'common.domain'|trans }}</label>
        <select id="domain" name="domain">
            {% if can_choose_none %}<option value="">{{ 'admin.user_new.no_domain_platform_staff'|trans }}</option>{% endif %}
            {% for d in domains %}<option value="{{ d.code }}" {{ d.code == values.domain ? 'selected' }}>{{ d.path }} · {{ d.name }}</option>{% endfor %}
        </select>
        <p class="help">{{ 'admin.user_new.rights_are_given_after_creation'|trans }}</p>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
        <button type="submit">{{ 'admin.user_new.create_and_send_invitation'|trans }}</button>
    </form>
{% endblock %}
