{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ 'common.profiles'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'common.profiles'|trans }}</h1>
    <p class="sub">{{ 'admin.profiles.named_sets_rights_pricer_fleet'|trans }}</p>

    {% if can_edit %}
        <div class="actions toolbar"><button type="button" data-open-profile="create">{{ 'admin.new_profile'|trans }}</button></div>
    {% endif %}

    <table>
        <thead><tr><th>{{ 'admin.profile_label'|trans }}</th><th>{{ 'common.rights'|trans }}</th><th>{{ 'admin.description'|trans }}</th><th>{{ 'admin.status'|trans }}</th>{% if can_edit %}<th class="num">{{ 'admin.operations'|trans }}</th>{% endif %}</tr></thead>
        <tbody>
        {% for p in profiles %}
            {% set used = usage[p.code] ?? 0 %}
            <tr>
                <td class="nowrap"><a href="{{ path('app_admin_profile', {code: p.code}) }}">{{ p.name }}</a> <span class="muted expr">{{ p.code }}</span></td>
                <td class="expr">{{ p.expression }}</td>
                <td class="muted">{{ p.description }}</td>
                <td class="nowrap">{% if used > 0 %}<span class="badge in-use">{{ 'admin.profiles.given_count'|trans({'{count}': used}) }}</span>{% else %}<span class="muted">{{ 'admin.unused'|trans }}</span>{% endif %}</td>
                {% if can_edit %}
                    <td class="num nowrap">{{ include('admin/_profile_operations.html.twig', {p: p, used: used}) }}</td>
                {% endif %}
            </tr>
        {% else %}
            <tr><td colspan="{{ can_edit ? 5 : 4 }}" class="muted">{{ (can_edit ? 'admin.profiles.no_profile_yet_create_first' : 'admin.profiles.no_profile_yet')|trans }}</td></tr>
        {% endfor %}
        </tbody>
    </table>

    {% if can_edit %}
        {{ include('admin/_profile_dialog.html.twig', {from: 'list'}) }}
        {% include 'admin/_confirm.html.twig' %}
    {% endif %}
{% endblock %}
