{#
 # Dialog to create or edit a profile (public/scripts/profiles.js), shared by the list and the detail page.
 # "dialog" (from the controller) opens it at once: an error to correct, or rights of users to confirm.
 # from: "list" or "detail", the page to come back to.
 #}
{% set d = dialog ?? null %}
{% set v = d ? d.values : {code: '', name: '', rights: '', description: ''} %}
<dialog id="profile-dialog" class="modal modal-wide" aria-labelledby="profile-dialog-title" {{ d ? 'data-open' }}
        data-title-create="{{ 'admin.new_profile'|trans }}" data-title-edit="{{ 'admin.profile_dialog.edit_profile_name'|trans({'{name}': '{name}'}) }}"
        data-label-create="{{ 'admin.create'|trans }}" data-label-save="{{ 'admin.save'|trans }}">
    <form method="post" action="{{ d and d.mode == 'edit' ? path('app_admin_profile_update', {code: v.code}) : path('app_admin_profile_create') }}"
          data-create-action="{{ path('app_admin_profile_create') }}" data-edit-action="{{ path('app_admin_profile_update', {code: '__code__'}) }}">
        <h2 id="profile-dialog-title">{{ d and d.mode == 'edit' ? 'admin.profile_dialog.edit_profile_name'|trans({'{name}': v.name}) : 'admin.new_profile'|trans }}</h2>

        {% if d and d.error %}<div class="alert error" data-dialog-message>{{ d.error|trans }}</div>{% endif %}

        {% if d and d.impact is not empty %}
            <section class="impact" data-dialog-message>
                <h3>{{ 'admin.profile_dialog.rights_change_count'|trans({'{count}': d.impact|length}) }}</h3>
                <p class="help">{{ 'admin.profile_dialog.users_keep_their_adjustments_new'|trans }}</p>
                <table>
                    <thead><tr><th>{{ 'common.user'|trans }}</th><th>{{ 'common.domain'|trans }}</th><th>{{ 'admin.profile_dialog.now'|trans }}</th><th>{{ 'admin.profile_dialog.after_change'|trans }}</th></tr></thead>
                    <tbody>
                    {% for change in d.impact %}
                        <tr>
                            <td>{{ change.grant.user.username }}</td>
                            <td class="expr">{{ change.grant.domain.path }}{{ change.grant.includesSubdomains ? ' +' : '' }}</td>
                            <td class="expr muted">{{ change.before }}</td>
                            <td class="expr">{{ change.after }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </section>
            <input type="hidden" name="confirmed" value="{{ v.rights }}" data-dialog-message>
        {% endif %}

        <div class="row">
            <div class="grow"><label for="p-name">{{ 'common.name'|trans }}</label>
                <input type="text" id="p-name" name="name" value="{{ v.name }}" required maxlength="255" placeholder="{{ 'admin.profile_dialog.pricer'|trans }}"></div>
            <div><label for="p-code">{{ 'admin.code'|trans }}</label>
                <input type="text" id="p-code" name="code" value="{{ v.code }}" required pattern="[a-z][a-z0-9_\-]{0,62}" placeholder="pricer" {{ d and d.mode == 'edit' ? 'readonly' }}></div>
        </div>
        <label for="p-rights">{{ 'common.rights'|trans }}</label>
        <input type="text" id="p-rights" name="rights" class="expr" value="{{ v.rights }}" required placeholder="vehicle.pricing:w">
        <p class="help">{{ 'admin.types'|trans }} {% for t in resource_types %}<code>{{ t.code }}</code> {% for f in t.facets %}<code title="{{ f.description ?? f.label }}">{{ f.code }}</code> {% endfor %}{% endfor %}{% for code, label in reserved_types %}<code title="{{ ('resource_type.reserved.' ~ code|slice(1))|trans }}">{{ code }}</code> {% endfor %}
            · <a href="{{ path('app_admin_resource_types') }}">{{ 'admin.syntax'|trans }}</a>. {{ 'admin.profile_dialog.only_someone_holding_rights_can'|trans }}</p>
        <label for="p-description">{{ 'admin.description'|trans }}</label>
        <input type="text" id="p-description" name="description" value="{{ v.description }}" maxlength="255" placeholder="{{ 'admin.profile_dialog.changes_prices_vehicles'|trans }}">

        <input type="hidden" name="from" value="{{ from }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_profile') }}">
        <div class="actions">
            <button type="submit">{{ d and d.impact is not empty ? 'admin.profile_dialog.confirm_and_change_count'|trans({'{count}': d.impact|length}) : (d and d.mode == 'edit' ? 'admin.save'|trans : 'admin.create'|trans) }}</button>
            <button type="button" class="secondary" data-close-dialog>{{ 'common.cancel'|trans }}</button>
        </div>
        {% if d and d.impact is not empty %}<p class="help" data-dialog-message>{{ 'admin.profile_dialog.if_you_change_rights_again'|trans }}</p>{% endif %}
    </form>
</dialog>
<script src="/scripts/profiles.js" defer></script>
