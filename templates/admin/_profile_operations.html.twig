{# Edit (dialog) and Remove (confirmation) buttons of a profile; "used": number of grants that have it. #}
<button type="button" class="small secondary" data-open-profile="edit" data-code="{{ p.code }}" data-name="{{ p.name }}"
        data-rights="{{ p.expression }}" data-description="{{ p.description }}">Edit</button>
<form method="post" action="{{ path('app_admin_profile_delete', {code: p.code}) }}" class="inline"
      data-confirm-title="Remove the profile {{ p.name }}?" data-confirm-text="Nobody has it any more. It can be created again later with the same code.">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_profile') }}">
    <button type="submit" class="small danger" {{ used > 0 ? 'disabled title="Change the rights of the users who have it first"' }}>Remove</button>
</form>
