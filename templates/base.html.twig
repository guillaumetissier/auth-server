<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{% block title %}Sign in{% endblock %} · {{ app_name }}</title>
    <style>
        :root {
            --bg: #f4f5f7; --card: #ffffff; --text: #1d2330; --muted: #5d6676; --border: #d9dde4;
            --accent: #1f5eff; --accent-text: #ffffff; --error-bg: #fdecec; --error: #a4161a; --ok-bg: #e8f6ee; --ok: #19663b;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #12151b; --card: #1b2029; --text: #e7eaf0; --muted: #9aa3b2; --border: #2e3542;
                --accent: #5b8cff; --error-bg: #3a1c1e; --error: #ff9c9f; --ok-bg: #173225; --ok: #8fe0b1;
            }
        }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px;
               background: var(--bg); color: var(--text); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
        main { width: 100%; max-width: 400px; background: var(--card); border: 1px solid var(--border);
               border-radius: 12px; padding: 32px 28px; }
        h1 { font-size: 1.35rem; margin: 0 0 4px; }
        .sub { color: var(--muted); margin: 0 0 24px; font-size: .95rem; }
        label { display: block; font-weight: 600; font-size: .9rem; margin: 16px 0 6px; }
        input[type=text], input[type=password] { width: 100%; padding: 10px 12px; font: inherit; color: var(--text);
               background: transparent; border: 1px solid var(--border); border-radius: 8px; }
        input:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        button, a.button { display: block; text-align: center; text-decoration: none; box-sizing: border-box; width: 100%; margin-top: 24px; padding: 11px; font: inherit; font-weight: 600; cursor: pointer;
                 color: var(--accent-text); background: var(--accent); border: 0; border-radius: 8px; }
        button.secondary, a.button.secondary { background: transparent; color: var(--text); border: 1px solid var(--border); }
        button:disabled { opacity: .5; cursor: not-allowed; }
        .alert { padding: 10px 12px; border-radius: 8px; font-size: .92rem; margin-bottom: 16px; }
        .alert.error { background: var(--error-bg); color: var(--error); }
        .alert.ok { background: var(--ok-bg); color: var(--ok); }
        .code { letter-spacing: .3em; font-size: 1.3rem; text-align: center; font-variant-numeric: tabular-nums; }
        .links { margin-top: 20px; text-align: center; font-size: .9rem; }
        a { color: var(--accent); }
        .qr { display: block; margin: 8px auto 12px; width: 220px; height: 220px; background: #fff; padding: 10px; border-radius: 8px; }
        .secret { font-family: ui-monospace, monospace; text-align: center; color: var(--muted); word-break: break-all; }
        ol.codes { columns: 2; font-family: ui-monospace, monospace; padding-left: 1.4em; }
        dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; margin: 0; }
        dt { color: var(--muted); }

        /* Administration pages (wider layout) */
        main.wide { max-width: 1040px; place-self: start center; }
        .wide nav.admin { display: flex; gap: 18px; flex-wrap: wrap; font-size: .92rem; margin: -8px 0 20px; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
        .wide nav.admin .who { margin-left: auto; color: var(--muted); }
        .wide h2 { font-size: 1.05rem; margin: 28px 0 10px; }
        .wide button, .wide a.button { display: inline-block; width: auto; margin-top: 10px; padding: 8px 14px; }
        .wide button.small, .wide a.button.small { margin: 0; padding: 4px 10px; font-size: .85rem; font-weight: 500; }
        .wide button.danger { background: transparent; color: var(--error); border: 1px solid var(--error); }
        .wide form.inline { display: inline; }
        .wide .nowrap { white-space: nowrap; }
        .wide .toolbar { margin: 16px 0 8px; }
        .wide .badge.in-use { color: var(--accent); border-color: currentColor; }
        .wide td.num form.inline { margin-left: 4px; }
        .wide button:disabled { opacity: .45; cursor: not-allowed; }
        dialog.modal { width: min(520px, calc(100vw - 32px)); padding: 0; border: 1px solid var(--border); border-radius: 12px; background: var(--card); color: var(--text); box-shadow: 0 12px 40px rgba(0,0,0,.25); }
        dialog.modal input[readonly] { background: var(--bg); color: var(--muted); }
        dialog.modal::backdrop { background: rgba(0,0,0,.45); }
        dialog.modal form, dialog.modal .modal-body { padding: 20px 22px; }
        dialog.modal p { margin: 8px 0 0; }
        .wide dialog.modal button.danger { background: var(--error); color: #fff; border-color: var(--error); }
        dialog.modal h2 { margin: 0 0 6px; font-size: 1.1rem; }
        dialog.modal .actions { margin-top: 18px; display: flex; gap: 8px; }
        [hidden] { display: none !important; }
        button.help-icon { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; min-width: 0;
            padding: 0; margin: 0 0 0 6px; border-radius: 50%; font-size: .75rem; font-weight: 700; line-height: 1;
            background: transparent; color: var(--accent); border: 1px solid currentColor; cursor: help; vertical-align: 1px; }
        .tip { position: relative; display: inline-block; }
        .tip-bubble { visibility: hidden; opacity: 0; transition: opacity .12s; position: absolute; z-index: 10; left: -8px; top: calc(100% + 8px);
            width: min(420px, calc(100vw - 48px)); padding: 12px 14px; border-radius: 10px; border: 1px solid var(--border);
            background: var(--card); color: var(--text); box-shadow: 0 8px 28px rgba(0,0,0,.2);
            font-family: inherit; font-size: .88rem; line-height: 1.5; white-space: normal; text-align: left; }
        .tip-bubble::before { content: ""; position: absolute; top: -6px; left: 14px; width: 10px; height: 10px;
            background: var(--card); border-left: 1px solid var(--border); border-top: 1px solid var(--border); transform: rotate(45deg); }
        .tip:hover .tip-bubble, .tip:focus-within .tip-bubble { visibility: visible; opacity: 1; }
        .wide .row { display: flex; gap: 12px; flex-wrap: wrap; align-items: end; }
        .wide .row > div { flex: 1 1 160px; }
        .wide .row > div.grow { flex: 3 1 280px; }
        .wide .row label { margin-top: 0; }
        select { width: 100%; padding: 9px 10px; font: inherit; color: var(--text); background: var(--card); border: 1px solid var(--border); border-radius: 8px; }
        label.check { display: flex; gap: 8px; align-items: center; font-weight: 500; margin: 0; padding-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; font-size: .92rem; }
        th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
        th { color: var(--muted); font-weight: 600; font-size: .85rem; }
        td.num, th.num { text-align: right; }
        code, .expr { font-family: ui-monospace, monospace; font-size: .88rem; }
        .muted { color: var(--muted); }
        .badge { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: .8rem; border: 1px solid var(--border); }
        .lvl-none { color: var(--muted); }
        .lvl-read { color: var(--accent); }
        .lvl-write { color: var(--ok); font-weight: 600; }
        .lvl-manage { color: var(--error); font-weight: 600; }
        .tree { padding-left: calc(var(--depth, 0) * 22px); }
        .help { font-size: .85rem; color: var(--muted); margin: 6px 0 0; }
        .wide table + form, .wide table + h3 { margin-top: 16px; }
        .wide h3 { font-size: .95rem; margin: 20px 0 0; }
        .wide nav.admin a[aria-current=page] { font-weight: 700; text-decoration: none; color: var(--text); }
        .wide input[type=text], .wide input[type=password], .wide input[type=email] { padding: 8px 10px; }
        input[type=email] { width: 100%; padding: 10px 12px; font: inherit; color: var(--text); background: transparent; border: 1px solid var(--border); border-radius: 8px; }
        .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin: 8px 0 4px; }
        .card { border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; }
        .card .value { font-size: 1.6rem; font-weight: 700; font-variant-numeric: tabular-nums; }
        .card .label { color: var(--muted); font-size: .85rem; }
        .meter { height: 6px; border-radius: 3px; background: var(--border); overflow: hidden; margin-top: 8px; }
        .meter > span { display: block; height: 100%; background: var(--ok); }
        .notice { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap;
                  padding: 10px 14px; border-radius: 8px; margin: 8px 0; border: 1px solid var(--border); }
        .notice.warn { background: var(--error-bg); color: var(--error); border-color: transparent; }
        .notice.info { background: var(--ok-bg); color: var(--ok); border-color: transparent; }
        .notice a.button { margin: 0; }
        .columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 0 28px; }
        .badge.ok { color: var(--ok); border-color: var(--ok); }
        .badge.warn { color: var(--error); border-color: var(--error); }
        section.impact { border: 1px solid #d9a400; background: rgba(217,164,0,.07); border-radius: 10px; padding: 4px 16px 12px; margin: 16px 0; }
        section.impact h2 { margin-top: 12px; }
        section.danger { border: 1px solid var(--error); border-radius: 10px; padding: 4px 16px 16px; margin-top: 28px; }
        section.danger h2 { color: var(--error); }
    </style>
</head>
<body>
<main{% block main_attributes %}{% endblock %}>
    {% block flashes %}{{ include('_flashes.html.twig') }}{% endblock %}
    {% block body %}{% endblock %}
</main>
</body>
</html>
