{% extends 'base.html.twig' %}

{% block title %}{{ 'account.backup_codes.backup_codes'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'account.backup_codes.save_backup_codes'|trans }}</h1>
    <p class="sub">{{ 'account.backup_codes.each_code_works_once_if'|trans }}</p>

    <ol class="codes">
        {% for code in codes %}
            <li>{{ code }}</li>
        {% endfor %}
    </ol>

    <a class="button" href="{{ continue_to }}">{{ 'account.backup_codes.i_have_saved_them_continue'|trans }}</a>
{% endblock %}
