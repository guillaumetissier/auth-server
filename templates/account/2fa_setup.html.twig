{% extends 'base.html.twig' %}

{% block title %}{{ 'account.set_up_two_factor_authentication'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'account.set_up_two_factor_authentication'|trans }}</h1>
    <p class="sub">
        {% if can_postpone and deadline %}
            {{ 'account.two_factor_setup.two_factor_authentication_will_be'|trans({'{date}': deadline|locale_date, '{days}': days_left}) }}
        {% elseif can_postpone %}
            {{ 'account.two_factor_setup.two_factor_authentication_will_soon'|trans }}
        {% else %}
            {{ 'account.two_factor_setup.two_factor_authentication_is_required'|trans }}
        {% endif %}
        {{ 'account.two_factor_setup.scan_code_with_google_authenticator'|trans }}
    </p>

    <img class="qr" src="{{ qr_code }}" alt="{{ 'account.two_factor_setup.qr_code_to_scan_with'|trans }}">
    <p class="secret">{{ 'account.two_factor_setup.or_enter_key_manually'|trans }}<br><strong>{{ secret }}</strong></p>

    {% if error %}
        <div class="alert error" role="alert">{{ error|trans }}</div>
    {% endif %}

    <form method="post">
        <label for="code">{{ 'account.two_factor_setup.code_shown_by_app'|trans }}</label>
        <input type="text" id="code" name="code" class="code" inputmode="numeric" pattern="[0-9]{6}"
               maxlength="6" autocomplete="one-time-code" required autofocus>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('totp_setup') }}">
        <button type="submit">{{ 'account.two_factor_setup.activate'|trans }}</button>
    </form>

    {% if can_postpone %}
        <form method="post" action="{{ path('app_2fa_postpone', return_to ? {return_to: return_to} : {}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('totp_postpone') }}">
            <button type="submit" class="secondary">{{ 'account.two_factor_setup.later'|trans }}</button>
        </form>
    {% endif %}

    <p class="links"><a href="{{ path('app_logout') }}">{{ 'common.sign_out'|trans }}</a></p>
{% endblock %}
