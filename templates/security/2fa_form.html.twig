{% extends 'base.html.twig' %}

{% block title %}{{ 'common.two_factor_authentication'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'common.two_factor_authentication'|trans }}</h1>
    <p class="sub">{{ 'security.two_factor_form.enter_6_digit_code_from'|trans }}</p>

    {% if authenticationError %}
        <div class="alert error" role="alert">
            {% if authenticationError == 'code_invalid' %}{{ 'security.two_factor_form.code_is_not_valid'|trans }}
            {% elseif authenticationError == 'code_reused' %}{{ 'security.two_factor_form.code_has_already_been_used'|trans }}
            {% else %}{{ 'security.two_factor_form.authentication_failed_please_try_again'|trans }}{% endif %}
        </div>
    {% endif %}

    <form method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}">
        <label for="_auth_code">{{ 'security.two_factor_form.authentication_code'|trans }}</label>
        <input type="text" id="_auth_code" name="{{ authCodeParameterName }}" class="code"
               autocomplete="one-time-code" autofocus required maxlength="11">

        {% if isCsrfProtectionEnabled %}
            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
        {% endif %}

        <button type="submit">{{ 'security.two_factor_form.verify'|trans }}</button>
    </form>

    <p class="links"><a href="{{ logoutPath }}">{{ 'security.two_factor_form.cancel_and_sign_out'|trans }}</a></p>
{% endblock %}
