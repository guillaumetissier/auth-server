{% extends 'base.html.twig' %}

{% block title %}{{ 'common.sign_in'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'common.sign_in'|trans }}</h1>
    <p class="sub">{{ app_name }}</p>

    {% if error %}
        {# Same message for unknown user and wrong password: no account enumeration. Translated by Symfony. #}
        <div class="alert error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <label for="username">{{ 'common.username'|trans }}</label>
        <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>

        <label for="password">{{ 'common.password'|trans }}</label>
        <input type="password" id="password" name="_password" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">{{ 'security.login.continue'|trans }}</button>
    </form>

    <p class="links"><a href="{{ path('app_password_forgot') }}">{{ 'common.forgot_password'|trans }}</a></p>
{% endblock %}
